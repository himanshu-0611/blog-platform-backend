datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model users {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(255)
  password   String
  is_active  Boolean
  is_archive Boolean
  email      String   @db.VarChar(255)
  role_id    String?
  created_on DateTime
  created_by String?
  updated_on DateTime @updatedAt
  updated_by String?

  role  roles?  @relation(fields: [role_id], references: [id])
  posts posts[]

  @@index([email])
}

model posts {
  id         String    @id @default(uuid())
  title      String
  content    String
  is_deleted Boolean
  user_id    String
  user       users     @relation(fields: [user_id], references: [id])
  created_on DateTime
  created_by String
  updated_on DateTime? @updatedAt
  updated_by String?
}

model roles {
  id         String    @id @default(uuid())
  role_name  String    @db.VarChar(255)
  created_on DateTime? @default(now())
  created_by String?
  updated_on DateTime? @updatedAt
  updated_by String?

  roleScopes roles_scopes[]
  users      users[]
}

model scopes {
  id         String    @id @default(uuid())
  module     String    @db.VarChar(255)
  action     String    @db.VarChar(255)
  scope_text String
  created_on DateTime? @default(now())
  created_by String?
  updated_on DateTime? @updatedAt
  updated_by String?

  roleScopes roles_scopes[]
}

model roles_scopes {
  id         String    @id @default(uuid())
  role       roles     @relation(fields: [role_id], references: [id])
  role_id    String
  scope      scopes    @relation(fields: [scope_id], references: [id])
  scope_id   String
  created_on DateTime? @default(now())
  created_by String?
  updated_on DateTime? @updatedAt
  updated_by String?
}

model system_logs {
  id               String   @id @default(uuid())
  endpoint         String
  request_headers  String
  request_body     String
  response_headers String
  response_body    String
  status_code      String?
  is_errorenous    Boolean  @default(false)
  exception        String?  
  created_on       DateTime @default(now())
  created_by       String?
  updated_on       DateTime @updatedAt
  updated_by       String?
}