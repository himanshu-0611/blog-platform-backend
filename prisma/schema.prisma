datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model users {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  password    String
  is_active   Boolean
  is_archive  Boolean
  email       String   @db.VarChar(255)
  //role_id     String?
  created_on  DateTime 
  created_by  String?
  updated_on  DateTime @updatedAt
  updated_by  String?

  //Role        Role?    @relation(fields: [role_id], references: [id])

  @@index([email]) 
  posts       posts[]
}

model posts {
  id          String   @id @default(uuid())
  title       String
  content     String
  is_deleted  Boolean
  user_id     String
  user        users    @relation(fields: [user_id], references: [id])  // fixed relation
  created_on  DateTime
  created_by  String?
  updated_on  DateTime @updatedAt
  updated_by  String?
}
